# ==============================================================================
# Radiant Medical -> Frappe Cloud (AKA) Migration Credentials & Paths
# ==============================================================================
# Copy this file to .env and fill in the required fields:
#   cp .env.example .env

# 1. Source: Radiant Medical REST API Credentials
RADIANT_BASE_URL=https://radiant-medical.frappe.cloud
RADIANT_API_KEY=
RADIANT_API_SECRET=

# 2. Destination: Frappe Cloud MariaDB Credentials
FC_HOST=
FC_PORT=3306
FC_DB=
FC_USER=
FC_PASS=

# 3. Post-Restore Admin Credentials
FC_ADMIN_USER=Administrator
FC_ADMIN_PASS=123

# 4. Backup Storage Directory (where DB and files archives live)
BACKUP_DIR=/mnt/c/Users/Administrator/Desktop/Radiant_ERP_Backup/database_backup/new
